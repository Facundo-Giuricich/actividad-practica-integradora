# Copiar este archivo a .env (cp .env.example .env) y ajustar los valores.

# --- Base de datos (PostgreSQL) ---
# Dentro de Docker Compose el host es el nombre del servicio: "db".
# Si corrés el backend fuera de Docker, usá DB_HOST=localhost y DB_PORT=5433.
DB_HOST=db
DB_PORT=5432
DB_USER=tlp4
DB_PASSWORD=tlp4
DB_NAME=tp_integrador
# Puerto por el que se publica la base en tu máquina (fuera de Docker).
# Dentro de la red de Compose el backend siempre usa db:5432.
DB_HOST_PORT=5433

# --- Backend ---
JWT_SECRET=cambiar-esto
API_PORT=3000

# --- Frontend ---
VITE_API_URL=http://localhost:3000/api
